/* Port of jozedash/dotfiles wofi config + base.css. Colours and the icon theme follow
 * the theme: colors.rasi is written by ~/.config/theme/theme-apply. */
configuration {
  modi: "drun,run,window";
  show-icons: true;
  drun-display-format: "{name}";
  display-drun: "";
  case-sensitive: false;
  font: "JetBrainsMono Nerd Font 11";
}

@import "colors.rasi"

* {
  background-color: transparent;
  text-color: @fg;
}

window {
  width: 800px;
  location: center;
  border: 2px;
  border-color: @accent;
  border-radius: 10px;
  background-color: @bg;
  padding: 5px;
}

mainbox { children: [inputbar, listview]; spacing: 5px; }

inputbar {
  background-color: @bg-inner;
  padding: 8px;
  border-radius: 5px;
  children: [entry];
}

entry { placeholder: "Search..."; placeholder-color: @fg-dim; }

listview {
  background-color: @bg-inner;
  lines: 8;
  dynamic: true;
  scrollbar: false;
  padding: 5px;
  border-radius: 5px;
}

element { padding: 5px; spacing: 10px; border-radius: 5px; border: 1px; border-color: transparent; }
element-icon { size: 25px; }
element-text { vertical-align: 0.5; }
element selected { background-color: @bg-selected; border-color: @fg; }
