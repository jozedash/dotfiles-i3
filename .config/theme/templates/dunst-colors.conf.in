# Generated by ~/.config/theme/theme-apply from templates/dunst-colors.conf.in.
# Don't edit: it's overwritten on every theme change. Mode: @mode@
# A dunstrc.d drop-in: dunst reads it after dunstrc.
[global]
    frame_color = "@primary@"

[urgency_low]
    background = "#@bg_opaque_hex@dd"
    foreground = "@fg@"
    frame_color = "@muted@"

[urgency_normal]
    background = "#@bg_opaque_hex@dd"
    foreground = "@fg@"
    frame_color = "@primary@"

[urgency_critical]
    background = "#@bg_opaque_hex@dd"
    foreground = "@fg@"
    frame_color = "@critical@"
