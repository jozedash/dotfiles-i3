/* Generated by ~/.config/theme/theme-apply from templates/rofi-colors.rasi.in.
 * Don't edit: it's overwritten on every theme change. Mode: @mode@ */
configuration {
  icon-theme: "@icon_theme@";
}

* {
  fg: @fg@;
  fg-dim: @fg_disabled@;
  bg: #@muted_hex@80;
  bg-inner: #@bg_opaque_hex@cc;
  bg-selected: #@bg_opaque_hex@b3;
  accent: @primary@;
}
