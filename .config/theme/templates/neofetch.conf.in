# Generated by ~/.config/theme/theme-apply from templates/neofetch.conf.in.
# Don't edit: it's overwritten on every theme change. Mode: @mode@
# Overrides neofetch's built-in defaults, which still apply to everything not set here.

# neofetch only takes 256-colour indices; this accepts #RRGGBB as well, so the theme's
# colours are used exactly. neofetch defines color() before sourcing this file.
color() {
    case $1 in
        "#"??????) printf '%b\e[38;2;%d;%d;%dm' "$reset" "0x${1:1:2}" "0x${1:3:2}" "0x${1:5:2}" ;;
        [0-6])     printf '%b\e[3%sm' "$reset" "$1" ;;
        7 | "fg")  printf '\e[37m%b' "$reset" ;;
        *)         printf '\e[38;5;%bm' "$1" ;;
    esac
}

# The logo in the pair; user@host in the secondary, keys in the primary, values in the text colour
ascii_colors=("@primary_text@" "@secondary_text@")
# title, @, underline, keys, colon, values
colors=("@secondary_text@" "@fg@" "@fg@" "@primary_text@" "@fg@" "@fg@")
