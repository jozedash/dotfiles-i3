# Generated by ~/.config/theme/theme-apply from templates/i3-colors.conf.in.
# Don't edit: it's overwritten on every theme change. Mode: @mode@
# i3 has no gradient borders, so the secondary is the split indicator.
# class                 border       backgr.        text            indicator      child_border
client.focused          @primary@    @bg_opaque@    @fg@            @secondary@    @primary@
client.focused_inactive @muted@      @bg_opaque@    @fg@            @muted@        @muted@
client.unfocused        @muted@      @bg_opaque@    @fg_disabled@   @muted@        @muted@
client.urgent           @critical@   @critical@     #ffffff         @critical@     @critical@
client.background       @bg_opaque@
