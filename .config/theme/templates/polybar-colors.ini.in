; Generated by ~/.config/theme/theme-apply from templates/polybar-colors.ini.in.
; Don't edit: it's overwritten on every theme change. Mode: @mode@
[colors]
background = #@bg_alpha_hex@@bg_opaque_hex@
foreground = @fg@
primary = @primary@
primary-text = @primary_text@
secondary = @secondary@
alert = @critical@
dim = @fg_disabled@
