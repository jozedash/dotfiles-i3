# Generated by ~/.config/theme/theme-apply from templates/lock-colors.sh.in.
# Don't edit: it's overwritten on every theme change. Mode: @mode@
# Sourced by ~/.config/i3/scripts/lock.sh; i3lock-color takes RRGGBBAA.
primary=@primary_hex@ee
# The ring's fill: the mode's panel background, as on the bar
inside=@bg_opaque_hex@@bg_alpha_hex@
secondary=@secondary_hex@ee
backspace=@color11_hex@ee
verify=@color10_hex@ee
wrong=@critical_hex@ee
greeter=@fg_disabled_hex@ff
